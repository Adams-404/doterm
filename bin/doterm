#!/data/data/com.termux/files/usr/bin/bash
set -e

DATA="$PREFIX/share/doterm"
CONFIG="$HOME/.termux"
BACKUPS="$CONFIG/backups/doterm"
CONFIG_FILES="font.ttf colors.properties termux.properties"

backup() {
    local file
    local dest="$BACKUPS/$(date +%Y%m%d-%H%M%S)"

    mkdir -p "$dest"
    : > "$dest/manifest"

    for file in $CONFIG_FILES; do
        if [ -f "$CONFIG/$file" ]; then
            cp "$CONFIG/$file" "$dest/$file"
            printf '%s\n' "$file" >> "$dest/manifest"
        fi
    done

    echo "Backup saved: $dest"
}

font() {
    local file

    case "${1:-}" in
        fira|fira-code)
            file="FiraCode-Regular.ttf"
            ;;
        jetbrains|jetbrains-mono)
            file="JetBrainsMonoNL-Regular.ttf"
            ;;
        *)
            echo "Usage: doterm font {fira|jetbrains}"
            return 1
            ;;
    esac

    if [ ! -f "$DATA/fonts/$file" ]; then
        echo "Font not installed: $file"
        return 1
    fi

    backup
    mkdir -p "$CONFIG"
    cp "$DATA/fonts/$file" "$CONFIG/font.ttf"
    termux-reload-settings
    echo "Font changed to $file"
}

preview() {
    local name="${1:-}"
    local file key value
    local background="" foreground="" cursor=""
    local -a colors=()

    if [ -z "$name" ]; then
        echo "Usage: doterm preview NAME"
        echo "Available themes:"
        for file in "$DATA"/themes/*.properties; do
            [ -f "$file" ] && basename "$file" .properties
        done
        return 1
    fi

    file="$DATA/themes/$name.properties"
    if [ ! -f "$file" ]; then
        echo "Theme not found: $name"
        echo "Run 'doterm list' to see available themes."
        return 1
    fi

    while IFS='=' read -r key value || [ -n "$key$value" ]; do
        case "$key" in
            background) background="$value" ;;
            foreground) foreground="$value" ;;
            cursor) cursor="$value" ;;
            color[0-9]|color1[0-5]) colors+=("$value") ;;
        esac
    done < "$file"

    printf '\nTheme preview: %s\n\n' "$name"
    printf 'Background: %s    Foreground: %s    Cursor: %s\n' "$background" "$foreground" "$cursor"

    if [[ "$background" =~ ^#[[:xdigit:]]{6}$ && "$foreground" =~ ^#[[:xdigit:]]{6}$ ]]; then
        printf '  \033[48;2;%d;%d;%dm\033[38;2;%d;%d;%dm  Sample text: Doterm preview  \033[0m\n' \
            "0x${background:1:2}" "0x${background:3:2}" "0x${background:5:2}" \
            "0x${foreground:1:2}" "0x${foreground:3:2}" "0x${foreground:5:2}"
    fi

    printf '\nANSI palette:\n'
    local i hex r g b
    for i in "${!colors[@]}"; do
        hex="${colors[$i]}"
        if [[ "$hex" =~ ^#[[:xdigit:]]{6}$ ]]; then
            r=$((16#${hex:1:2}))
            g=$((16#${hex:3:2}))
            b=$((16#${hex:5:2}))
            printf '  %2d \033[48;2;%d;%d;%dm  \033[0m %s' "$i" "$r" "$g" "$b" "$hex"
            if (( (i + 1) % 4 == 3 )); then printf '\n'; else printf '    '; fi
        else
            printf '  %2d [invalid color: %s]\n' "$i" "$hex"
        fi
    done
    printf '\nPreview only. Your current Termux theme was not changed.\n'
}

theme() {
    local name="${1:-}" file key value current="" choice answer
    local temp_dir="" had_colors=0
    local -a files=() names=()
    local -a required=(background foreground cursor color0 color1 color2 color3 color4 color5 color6 color7 color8 color9 color10 color11 color12 color13 color14 color15)
    local -A values=()

    for file in "$DATA"/themes/*.properties; do
        [ -f "$file" ] || continue
        files+=("$file")
        names+=("$(basename "$file" .properties)")
        if [ -f "$CONFIG/colors.properties" ] && cmp -s "$file" "$CONFIG/colors.properties"; then
            current="$(basename "$file" .properties)"
        fi
    done

    if [ -z "$name" ]; then
        if [ ! -t 0 ]; then
            echo "Available themes:"
            printf '  %s\n' "${names[@]}"
            echo "Usage: doterm theme NAME"
            return 0
        fi
        echo "Doterm theme picker"
        [ -n "$current" ] && echo "Active theme: $current" || echo "Active theme: custom or unknown"
        echo
        local i fg
        for i in "${!names[@]}"; do
            fg="$(awk -F= '$1=="foreground" {print $2; exit}' "${files[$i]}")"
            if [[ "$fg" =~ ^#[[:xdigit:]]{6}$ ]]; then
                printf '  \033[38;2;%d;%d;%dm%d) %s\033[0m' "$((16#${fg:1:2}))" "$((16#${fg:3:2}))" "$((16#${fg:5:2}))" "$((i + 1))" "${names[$i]}"
            else
                printf '  %d) %s' "$((i + 1))" "${names[$i]}"
            fi
            [ "${names[$i]}" = "$current" ] && printf ' (active)'
            printf '\n'
        done
        echo "  0) Cancel"
        printf 'Choose a theme number: '
        if ! read -r choice; then echo; echo "No selection made."; return 1; fi
        [[ "$choice" =~ ^[0-9]+$ ]] || { echo "Please enter a number from 0 to ${#names[@]}."; return 1; }
        choice=$((10#$choice))
        (( choice == 0 )) && { echo "Cancelled."; return 0; }
        (( choice >= 1 && choice <= ${#names[@]} )) || { echo "Invalid selection."; return 1; }
        name="${names[$((choice - 1))]}"
    fi

    file="$DATA/themes/$name.properties"
    if [ ! -f "$file" ]; then echo "Theme not found: $name"; echo "Run 'doterm list' to see available themes."; return 1; fi

    while IFS='=' read -r key value || [ -n "$key$value" ]; do
        [[ "$key" =~ ^(background|foreground|cursor|color([0-9]|1[0-5]))$ ]] || continue
        values["$key"]="$value"
    done < "$file"
    for key in "${required[@]}"; do
        if [[ ! "${values[$key]+present}" || ! "${values[$key]}" =~ ^#[[:xdigit:]]{6}$ ]]; then
            echo "Theme is invalid: $name (missing or invalid $key)."
            echo "Your current theme was not changed."
            return 1
        fi
    done

    temp_dir="$(mktemp -d)"
    if [ -f "$CONFIG/colors.properties" ]; then cp "$CONFIG/colors.properties" "$temp_dir/colors.properties"; had_colors=1; fi
    preview_restore() {
        if [ "$had_colors" -eq 1 ]; then
            mkdir -p "$CONFIG"
            cp "$temp_dir/colors.properties" "$CONFIG/colors.properties"
        else
            rm -f "$CONFIG/colors.properties"
        fi
        command -v termux-reload-settings >/dev/null 2>&1 && termux-reload-settings
        rm -rf -- "$temp_dir"
    }
    trap 'preview_restore' INT TERM HUP

    mkdir -p "$CONFIG"
    cp "$file" "$CONFIG/colors.properties"
    termux-reload-settings
    echo
    echo "Temporarily applied: $name"
    printf 'Keep this theme? [y/N] '
    read -r answer || answer=""
    case "$answer" in
        y|Y|yes|YES|Yes)
            if [ "$had_colors" -eq 1 ]; then cp "$temp_dir/colors.properties" "$CONFIG/colors.properties"; else rm -f "$CONFIG/colors.properties"; fi
            backup
            cp "$file" "$CONFIG/colors.properties"
            termux-reload-settings
            rm -rf -- "$temp_dir"
            trap - INT TERM HUP
            echo "Theme applied and saved: $name"
            ;;
        *)
            preview_restore
            trap - INT TERM HUP
            echo "Cancelled. Your previous theme and settings have been restored."
            ;;
    esac
}

doctor() {
    local failures=0 warnings=0 count=0 file key value
    local -a required=(background foreground cursor color0 color1 color2 color3 color4 color5 color6 color7 color8 color9 color10 color11 color12 color13 color14 color15)
    local -A values=()
    pass() { printf '  [PASS] %s\n' "$1"; count=$((count + 1)); }
    warn() { printf '  [WARN] %s\n' "$1"; warnings=$((warnings + 1)); count=$((count + 1)); }
    fail() { printf '  [FAIL] %s\n' "$1"; failures=$((failures + 1)); count=$((count + 1)); }

    echo "Doterm doctor (read-only)"
    echo
    if [[ -n "${PREFIX:-}" && -d "${PREFIX:-}/bin" ]] && command -v pkg >/dev/null 2>&1; then
        pass "Termux environment detected"
    else
        fail "Termux environment not detected"
        echo "         Run this command inside Termux."
    fi
    if [[ -x "$PREFIX/bin/doterm" ]]; then pass "doterm command installed"; else fail "doterm command missing or not executable"; fi
    if [[ -x "$PREFIX/bin/font" ]]; then pass "font selector installed"; else fail "font selector missing or not executable"; fi

    for file in FiraCode-Regular.ttf JetBrainsMonoNL-Regular.ttf; do
        if [[ -s "$DATA/fonts/$file" ]]; then pass "Font present: $file"; else fail "Font missing or empty: $file"; fi
    done

    local themes=0 invalid=0
    if [[ -d "$DATA/themes" ]]; then
        for file in "$DATA"/themes/*.properties; do
            [[ -f "$file" ]] || continue
            themes=$((themes + 1))
            values=()
            while IFS='=' read -r key value || [[ -n "$key$value" ]]; do
                [[ "$key" =~ ^(background|foreground|cursor|color([0-9]|1[0-5]))$ ]] || continue
                values["$key"]="$value"
            done < "$file"
            for key in "${required[@]}"; do
                if [[ ! "${values[$key]+present}" || ! "${values[$key]}" =~ ^#[[:xdigit:]]{6}$ ]]; then
                    invalid=$((invalid + 1))
                    break
                fi
            done
        done
    fi
    if (( themes == 0 )); then fail "No bundled theme files found"
    elif (( invalid > 0 )); then fail "$invalid of $themes themes have missing or invalid colors"
    else pass "All $themes bundled themes have valid required colors"; fi

    if [[ -f "$CONFIG/colors.properties" ]]; then pass "Active colors.properties exists"
    else warn "No active colors.properties file"; echo "         Apply one with: doterm theme"; fi
    if command -v termux-reload-settings >/dev/null 2>&1; then pass "termux-reload-settings available"
    else warn "termux-reload-settings not found"; fi

    echo
    printf 'Checks: %d | Warnings: %d | Failures: %d\n' "$count" "$warnings" "$failures"
    if (( failures > 0 )); then echo "Result: problems found."; return 1
    elif (( warnings > 0 )); then echo "Result: usable, but review warnings."
    else echo "Result: Doterm looks healthy."; fi
}

update() {
    (
        set -Eeuo pipefail

        if ! command -v git >/dev/null 2>&1; then
            echo "Git is required to update Doterm."
            echo "Install it with: pkg install git"
            exit 1
        fi

        local temp_dir
        temp_dir="$(mktemp -d)"
        trap 'rm -rf -- "$temp_dir"' EXIT

        echo "Checking for Doterm updates..."
        if ! git clone --depth 1 --branch main https://github.com/Adams-404/doterm.git "$temp_dir/doterm"; then
            echo "Update failed: could not download Doterm."
            echo "Check your internet connection and try again."
            exit 1
        fi

        local source="$temp_dir/doterm"
        if [[ ! -f "$source/install.sh" ||
              ! -f "$source/bin/doterm" ||
              ! -f "$source/bin/font" ||
              ! -d "$source/fonts" ||
              ! -d "$source/themes" ||
              ! -d "$source/licenses" ]]; then
            echo "Update failed: the downloaded repository is incomplete."
            exit 1
        fi

        echo "Installing the latest Doterm files..."
        if ! bash "$source/install.sh"; then
            echo "Update failed during installation."
            echo "Your existing Termux settings should remain unchanged."
            exit 1
        fi
        echo "Doterm update complete."
    )
}

restore() {
    local latest
    local file

    latest="$(ls -1dt "$BACKUPS"/*/ 2>/dev/null | head -n 1 || true)"

    if [ -z "$latest" ] || [ ! -d "$latest" ]; then
        echo "No Doterm backups found."
        return 1
    fi

    if [ ! -f "$latest/manifest" ]; then
        echo "This is an older backup without a manifest."
        echo "Restoring files available in that backup only."
        for file in $CONFIG_FILES; do
            [ ! -f "$latest/$file" ] || cp "$latest/$file" "$CONFIG/$file"
        done
    else
        echo "Restoring from: $latest"
        mkdir -p "$CONFIG"

        for file in $CONFIG_FILES; do
            if grep -Fxq "$file" "$latest/manifest"; then
                cp "$latest/$file" "$CONFIG/$file"
            else
                rm -f "$CONFIG/$file"
            fi
        done
    fi

    termux-reload-settings
    echo "Restore complete."
}


repair() {
    (
        set -Eeuo pipefail
        if ! command -v git >/dev/null 2>&1; then
            echo "Git is required to repair Doterm."
            echo "Install it with: pkg install git"
            exit 1
        fi
        local temp_dir source
        temp_dir="$(mktemp -d)"
        trap 'rm -rf -- "$temp_dir"' EXIT
        echo "Downloading a clean copy of Doterm..."
        if ! git clone --depth 1 --branch main https://github.com/Adams-404/doterm.git "$temp_dir/doterm"; then
            echo "Repair failed: could not download Doterm."
            exit 1
        fi
        source="$temp_dir/doterm"
        if [[ ! -f "$source/install.sh" || ! -f "$source/bin/doterm" || ! -f "$source/bin/font" || ! -d "$source/fonts" || ! -d "$source/themes" || ! -d "$source/licenses" ]]; then
            echo "Repair failed: the downloaded repository is incomplete."
            exit 1
        fi
        echo "Repairing Doterm files..."
        bash "$source/install.sh"
        echo "Repair complete. Your existing Termux settings and Doterm backups were preserved."
    )
}

uninstall() {
    local answer
    echo "This will remove the following Doterm-managed files:"
    echo "  - $PREFIX/bin/doterm"
    echo "  - $PREFIX/bin/font"
    echo "  - $PREFIX/share/doterm/ (bundled fonts, themes, and licenses)"
    echo
    echo "Your ~/.termux settings, active theme, font, and backups will be kept."
    printf 'Uninstall Doterm? [y/N] '
    read -r answer || answer=""
    case "$answer" in
        y|Y|yes|YES|Yes) ;;
        *) echo "Cancelled. Nothing was removed."; return 0 ;;
    esac

    rm -f -- "$PREFIX/bin/doterm" "$PREFIX/bin/font"
    rm -rf -- "$PREFIX/share/doterm"
    echo "Doterm has been uninstalled. Your Termux settings and backups were preserved."
}


status() {
    local file active_font="unknown" active_theme="custom or unknown" version="unversioned"
    if [[ -f "$DATA/VERSION" ]]; then IFS= read -r version < "$DATA/VERSION" || version="unknown"; fi
    echo "Doterm status"
    echo
    printf 'Version: %s\n' "$version"
    if [[ -f "$CONFIG/font.ttf" ]]; then
        if [[ -f "$DATA/fonts/FiraCode-Regular.ttf" ]] && cmp -s "$CONFIG/font.ttf" "$DATA/fonts/FiraCode-Regular.ttf"; then
            active_font="Fira Code"
        elif [[ -f "$DATA/fonts/JetBrainsMonoNL-Regular.ttf" ]] && cmp -s "$CONFIG/font.ttf" "$DATA/fonts/JetBrainsMonoNL-Regular.ttf"; then
            active_font="JetBrains Mono NL"
        else active_font="custom or unknown"; fi
    else active_font="Termux default (no Doterm font file)"; fi
    printf 'Font: %s\n' "$active_font"
    if [[ -f "$CONFIG/colors.properties" ]]; then
        for file in "$DATA"/themes/*.properties; do
            [[ -f "$file" ]] || continue
            if cmp -s "$file" "$CONFIG/colors.properties"; then active_theme="$(basename "$file" .properties)"; break; fi
        done
    else active_theme="not configured"; fi
    printf 'Theme: %s\n' "$active_theme"
    echo
    local fonts=0 themes=0
    if [[ -d "$DATA/fonts" ]]; then for file in "$DATA"/fonts/*.ttf; do [[ -f "$file" ]] && fonts=$((fonts + 1)); done; fi
    if [[ -d "$DATA/themes" ]]; then for file in "$DATA"/themes/*.properties; do [[ -f "$file" ]] && themes=$((themes + 1)); done; fi
    printf 'Installed fonts: %d\nInstalled themes: %d\n' "$fonts" "$themes"
}


case "${1:-help}" in
    font) shift; font "${1:-}" ;;
    theme) shift; theme "${1:-}" ;;
    preview) shift; preview "${1:-}" ;;
    backup) backup ;;
    restore) restore ;;
    update) update ;;
    repair) repair ;;
    uninstall) uninstall ;;
    doctor) doctor ;;
    status) status ;;
    list)
        echo "Doterm fonts:"
        if [[ -d "$DATA/fonts" ]]; then
            found=0
            for file in "$DATA"/fonts/*.ttf; do
                [[ -f "$file" ]] || continue
                found=1
                case "$(basename "$file")" in
                    FiraCode-Regular.ttf) echo "  Fira Code (fira)" ;;
                    JetBrainsMonoNL-Regular.ttf) echo "  JetBrains Mono NL (jetbrains)" ;;
                    *) printf '  %s\n' "$(basename "$file" .ttf)" ;;
                esac
            done
            if (( found == 0 )); then echo "  No font files found."; fi
        else echo "  Font directory missing. Try: doterm repair"; fi
        echo
        echo "Doterm themes:"
        if [[ -d "$DATA/themes" ]]; then
            found=0
            for file in "$DATA"/themes/*.properties; do
                [[ -f "$file" ]] || continue
                found=1
                printf '  %s\n' "$(basename "$file" .properties)"
            done
            if (( found == 0 )); then echo "  No theme files found."; fi
        else echo "  Theme directory missing. Try: doterm repair"; fi
        ;;
    help|--help|-h)
        echo "Doterm - Make your terminal yours"
        echo
        echo "Commands:"
        echo "  doterm font fira       Switch to Fira Code"
        echo "  doterm font jetbrains  Switch to JetBrains Mono NL"
        echo "  doterm theme [NAME]    Pick or apply a theme"
        echo "  doterm preview NAME    Preview a theme without applying it"
        echo "  doterm list            List available fonts and themes"
        echo "  doterm status          Show active font, theme, and version"
        echo "  doterm backup          Back up current settings"
        echo "  doterm restore         Restore the latest backup"
        echo "  doterm update          Update Doterm from GitHub"
        echo "  doterm repair          Repair/reinstall Doterm files"
        echo "  doterm uninstall       Remove Doterm, keeping your settings"
        echo "  doterm doctor          Check installation and theme health"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'doterm help' for usage."
        exit 1
        ;;
esac
