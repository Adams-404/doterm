#!/data/data/com.termux/files/usr/bin/bash
set -e

DATA="$PREFIX/share/doterm"
CONFIG="$HOME/.termux"
BACKUPS="$CONFIG/backups/doterm"
CONFIG_FILES="font.ttf colors.properties termux.properties"

backup() {
    local file
    local dest="$BACKUPS/$(date +%Y%m%d-%H%M%S)"

    mkdir -p "$dest"
    : > "$dest/manifest"

    for file in $CONFIG_FILES; do
        if [ -f "$CONFIG/$file" ]; then
            cp "$CONFIG/$file" "$dest/$file"
            printf '%s\n' "$file" >> "$dest/manifest"
        fi
    done

    echo "Backup saved: $dest"
}

font() {
    local file

    case "${1:-}" in
        fira|fira-code)
            file="FiraCode-Regular.ttf"
            ;;
        jetbrains|jetbrains-mono)
            file="JetBrainsMonoNL-Regular.ttf"
            ;;
        *)
            echo "Usage: doterm font {fira|jetbrains}"
            return 1
            ;;
    esac

    if [ ! -f "$DATA/fonts/$file" ]; then
        echo "Font not installed: $file"
        return 1
    fi

    backup
    mkdir -p "$CONFIG"
    cp "$DATA/fonts/$file" "$CONFIG/font.ttf"
    termux-reload-settings
    echo "Font changed to $file"
}

preview() {
    local name="${1:-}"
    local file key value
    local background="" foreground="" cursor=""
    local -a colors=()

    if [ -z "$name" ]; then
        echo "Usage: doterm preview NAME"
        echo "Available themes:"
        for file in "$DATA"/themes/*.properties; do
            [ -f "$file" ] && basename "$file" .properties
        done
        return 1
    fi

    file="$DATA/themes/$name.properties"
    if [ ! -f "$file" ]; then
        echo "Theme not found: $name"
        echo "Run 'doterm list' to see available themes."
        return 1
    fi

    while IFS='=' read -r key value || [ -n "$key$value" ]; do
        case "$key" in
            background) background="$value" ;;
            foreground) foreground="$value" ;;
            cursor) cursor="$value" ;;
            color[0-9]|color1[0-5]) colors+=("$value") ;;
        esac
    done < "$file"

    printf '\nTheme preview: %s\n\n' "$name"
    printf 'Background: %s    Foreground: %s    Cursor: %s\n' "$background" "$foreground" "$cursor"

    if [[ "$background" =~ ^#[[:xdigit:]]{6}$ && "$foreground" =~ ^#[[:xdigit:]]{6}$ ]]; then
        printf '  \033[48;2;%d;%d;%dm\033[38;2;%d;%d;%dm  Sample text: Doterm preview  \033[0m\n' \
            "0x${background:1:2}" "0x${background:3:2}" "0x${background:5:2}" \
            "0x${foreground:1:2}" "0x${foreground:3:2}" "0x${foreground:5:2}"
    fi

    printf '\nANSI palette:\n'
    local i hex r g b
    for i in "${!colors[@]}"; do
        hex="${colors[$i]}"
        if [[ "$hex" =~ ^#[[:xdigit:]]{6}$ ]]; then
            r=$((16#${hex:1:2}))
            g=$((16#${hex:3:2}))
            b=$((16#${hex:5:2}))
            printf '  %2d \033[48;2;%d;%d;%dm  \033[0m %s' "$i" "$r" "$g" "$b" "$hex"
            if (( (i + 1) % 4 == 3 )); then printf '\n'; else printf '    '; fi
        else
            printf '  %2d [invalid color: %s]\n' "$i" "$hex"
        fi
    done
    printf '\nPreview only. Your current Termux theme was not changed.\n'
}

theme() {
    local name="${1:-}"
    local file

    if [ -z "$name" ]; then
        echo "Usage: doterm theme NAME"
        echo "Available themes:"
        for file in "$DATA"/themes/*.properties; do
            [ -f "$file" ] && basename "$file" .properties
        done
        return 1
    fi

    file="$DATA/themes/$name.properties"

    if [ ! -f "$file" ]; then
        echo "Theme not found: $name"
        return 1
    fi

    backup
    mkdir -p "$CONFIG"
    cp "$file" "$CONFIG/colors.properties"
    termux-reload-settings
    echo "Theme applied: $name"
}

update() {
    (
        set -Eeuo pipefail

        if ! command -v git >/dev/null 2>&1; then
            echo "Git is required to update Doterm."
            echo "Install it with: pkg install git"
            exit 1
        fi

        local temp_dir
        temp_dir="$(mktemp -d)"
        trap 'rm -rf -- "$temp_dir"' EXIT

        echo "Checking for Doterm updates..."
        if ! git clone --depth 1 --branch main https://github.com/Adams-404/doterm.git "$temp_dir/doterm"; then
            echo "Update failed: could not download Doterm."
            echo "Check your internet connection and try again."
            exit 1
        fi

        local source="$temp_dir/doterm"
        if [[ ! -f "$source/install.sh" ||
              ! -f "$source/bin/doterm" ||
              ! -f "$source/bin/font" ||
              ! -d "$source/fonts" ||
              ! -d "$source/themes" ||
              ! -d "$source/licenses" ]]; then
            echo "Update failed: the downloaded repository is incomplete."
            exit 1
        fi

        echo "Installing the latest Doterm files..."
        if ! bash "$source/install.sh"; then
            echo "Update failed during installation."
            echo "Your existing Termux settings should remain unchanged."
            exit 1
        fi
        echo "Doterm update complete."
    )
}

restore() {
    local latest
    local file

    latest="$(ls -1dt "$BACKUPS"/*/ 2>/dev/null | head -n 1 || true)"

    if [ -z "$latest" ] || [ ! -d "$latest" ]; then
        echo "No Doterm backups found."
        return 1
    fi

    if [ ! -f "$latest/manifest" ]; then
        echo "This is an older backup without a manifest."
        echo "Restoring files available in that backup only."
        for file in $CONFIG_FILES; do
            [ ! -f "$latest/$file" ] || cp "$latest/$file" "$CONFIG/$file"
        done
    else
        echo "Restoring from: $latest"
        mkdir -p "$CONFIG"

        for file in $CONFIG_FILES; do
            if grep -Fxq "$file" "$latest/manifest"; then
                cp "$latest/$file" "$CONFIG/$file"
            else
                rm -f "$CONFIG/$file"
            fi
        done
    fi

    termux-reload-settings
    echo "Restore complete."
}

case "${1:-help}" in
    font) shift; font "${1:-}" ;;
    theme) shift; theme "${1:-}" ;;
    backup) backup ;;
    restore) restore ;;
    update) update ;;
    list)
        echo "Fonts:"
        ls "$DATA/fonts"
        echo
        echo "Themes:"
        ls "$DATA/themes"
        ;;
    help|--help|-h)
        echo "Doterm - Make your terminal yours"
        echo
        echo "Commands:"
        echo "  doterm font fira       Switch to Fira Code"
        echo "  doterm font jetbrains  Switch to JetBrains Mono NL"
        echo "  doterm theme NAME      Apply a theme"
        echo "  doterm list            List available fonts and themes"
        echo "  doterm backup          Back up current settings"
        echo "  doterm restore         Restore the latest backup"
        echo "  doterm update          Update Doterm from GitHub"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'doterm help' for usage."
        exit 1
        ;;
esac
